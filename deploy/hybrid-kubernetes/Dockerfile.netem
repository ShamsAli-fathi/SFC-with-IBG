# kind's pinned node image already contains the tc/netem userspace utility.
# Copy only tc, its runtime libraries, and the normal-delay distribution table
# into a Hybrid-owned scratch image. This avoids an online package install and
# does not depend on an unrelated historical IBG-Exact runtime tag.
FROM kindest/node:v1.36.1@sha256:3489c7674813ba5d8b1a9977baea8a6e553784dab7b84759d1014dbd78f7ebd5 AS tc-source

RUN test -x /usr/sbin/tc \
    && test -r /usr/lib/x86_64-linux-gnu/tc/normal.dist

FROM scratch

COPY --from=tc-source /usr/sbin/tc /usr/sbin/tc
COPY --from=tc-source /usr/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 /lib64/ld-linux-x86-64.so.2
COPY --from=tc-source /usr/lib/x86_64-linux-gnu/libbpf.so* /lib/x86_64-linux-gnu/
COPY --from=tc-source /usr/lib/x86_64-linux-gnu/libelf*.so* /lib/x86_64-linux-gnu/
COPY --from=tc-source /usr/lib/x86_64-linux-gnu/libmnl.so* /lib/x86_64-linux-gnu/
COPY --from=tc-source /usr/lib/x86_64-linux-gnu/libcap.so* /lib/x86_64-linux-gnu/
COPY --from=tc-source /usr/lib/x86_64-linux-gnu/libm.so* /lib/x86_64-linux-gnu/
COPY --from=tc-source /usr/lib/x86_64-linux-gnu/libxtables.so* /lib/x86_64-linux-gnu/
COPY --from=tc-source /usr/lib/x86_64-linux-gnu/libc.so* /lib/x86_64-linux-gnu/
COPY --from=tc-source /usr/lib/x86_64-linux-gnu/libz.so* /lib/x86_64-linux-gnu/
COPY --from=tc-source /usr/lib/x86_64-linux-gnu/libzstd.so* /lib/x86_64-linux-gnu/
COPY --from=tc-source /usr/lib/x86_64-linux-gnu/tc/normal.dist /usr/lib/x86_64-linux-gnu/tc/normal.dist

ENTRYPOINT ["/usr/sbin/tc"]
