FROM mcr.microsoft.com/azurelinux/base/python:3.12

USER root

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/IBG

WORKDIR /app

# The controller alone owns the SciPy/HiGHS MILP backend.
COPY requirements-runtime.txt ./
RUN python3 -m pip install --no-cache-dir -r requirements-runtime.txt "scipy==1.18.0"

COPY IBG ./IBG
COPY MILP ./MILP
COPY testbed ./testbed

USER 10001:10001

CMD ["python3", "-m", "MILP.kernel_controller"]
